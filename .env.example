# ==================================================
# DataGalactic Fullstack Environment Config Example
# Copy this file to .env and adjust values as needed
# ==================================================

# Backend Server Configuration
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# Database Configuration (MySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=datagalactic
# Or Cloud MySQL URI (e.g. Aiven, Railway, TiDB Cloud, Clever Cloud):
# MYSQL_URL=mysql://user:password@host:3306/datagalactic

# Company Information
COMPANY_NAME=DataGalactic
COMPANY_EMAIL=hello@datagalactic.in
COMPANY_PHONE=+91 9363164608

# Admin Credentials & Security
ADMIN_EMAIL=admin@datagalactic.in
ADMIN_PASSWORD=Admin@DG2026!
ADMIN_JWT_SECRET=your_jwt_secret_key_here

# Frontend API Base URL (Client & Admin)
VITE_API_BASE_URL=http://127.0.0.1:5000

# ==============================================================================
# REAL-TIME EMAIL NOTIFICATIONS (Registration Form & Feedback Form)
# ==============================================================================
# Email address where admin alerts for new leads and feedbacks will be sent:
ADMIN_NOTIFICATION_EMAIL=admin@datagalactic.in

# ------------------------------------------------------------------------------
# OPTION 1: Gmail SMTP (Recommended & Easiest for Real Inbox Delivery)
# ------------------------------------------------------------------------------
# 1. Turn on 2-Step Verification in Google: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
# 3. Enter your details below:
# SMTP_SERVICE=gmail
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM=DataGalactic <your_email@gmail.com>

# ------------------------------------------------------------------------------
# OPTION 2: Custom / Hosted SMTP (Zoho, Brevo, SendGrid, Hostinger, AWS SES)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM="DataGalactic" <hello@datagalactic.in>
